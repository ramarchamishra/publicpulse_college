# Relative paths resolve from backend/. Existing analytics data is never migrated.
PUBLICPULSE_DATABASE=database/publicpulse.db
PUBLICPULSE_JOB_DATABASE=instance/jobs.sqlite3
PUBLICPULSE_MAX_PENDING_JOBS=8
# X session cookies used by the existing Twikit collector.
X_AUTHTOKEN=
X_CT0=
X_TWID=
X_GUEST_ID=
X_GUEST_ID_ADS=
X_GUEST_ID_MARKETING=
X_PERSONALIZATION_ID=
# Optional: use only already-cached models, without contacting Hugging Face.
# HF_HUB_OFFLINE=1
